<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Akka.TestKit.Xunit" Version="1.5.73" />
    <PackageReference Include="Akka.Persistence.TestKit.Xunit" Version="1.5.73" />
    <PackageReference Include="Akka.Hosting.TestKit" Version="1.5.73" />
    <PackageReference Include="Akka.Cluster.Hosting" Version="1.5.73" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.6.0" />
    <PackageReference Include="CsCheck" Version="5.0.1" />
    <PackageReference Include="Verify.XunitV3" Version="33.3.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
