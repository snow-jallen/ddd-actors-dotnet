<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Akka.Cluster.Hosting" Version="1.5.73" />
    <PackageReference Include="Akka.Persistence.Hosting" Version="1.5.73" />
    <PackageReference Include="Akka.Persistence.Sql.Hosting" Version="1.5.73" />
    <PackageReference Include="Akka.Management" Version="1.5.73" />
    <PackageReference Include="Akka.Discovery.KubernetesApi" Version="1.5.73" />
    <PackageReference Include="Microsoft.FeatureManagement" Version="4.8.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>
  <!-- Services only: make Akka's app-version = assembly-version track MAJOR.MINOR.PATCH -->
  <Target Name="AkkaAppVersionFromMinVer" AfterTargets="MinVer">
    <PropertyGroup>
      <AssemblyVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch).0</AssemblyVersion>
    </PropertyGroup>
  </Target>
  <Target Name="TagImageWithMinVer" AfterTargets="MinVer">
    <PropertyGroup>
      <ContainerImageTags>$(MinVerVersion);$(MinVerMajor).$(MinVerMinor)</ContainerImageTags>
    </PropertyGroup>
  </Target>
</Project>
